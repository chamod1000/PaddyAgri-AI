# API Keys Configuration
# Primary Classification & Routing Provider (Groq Cloud)
GROQ_API_KEY=your_groq_api_key_here

# Primary Reasoning Provider (Google Gemini API via Google AI Studio)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Secondary Resilient Reasoning Provider (Cohere API)
COHERE_API_KEY=your_cohere_api_key_here

# Optional Fallback Provider (OpenRouter API)
OPENROUTER_API_KEY=your_openrouter_api_key_here
